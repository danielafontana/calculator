# Copy to .env to customize docker compose (all values are optional).

# Backend
PORT=8080
# Comma-separated list of allowed origins ("*" allows any origin)
CORS_ORIGINS=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info
APP_VERSION=1.0.0

# Host ports published by docker compose
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Frontend (build time): URL the browser uses to reach the API.
# Leave empty in local development to use the Vite proxy (/api -> :8080).
VITE_API_URL=http://localhost:8080
