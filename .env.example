# Copy to .env to customize docker compose (all values are optional).

# Backend
# Comma-separated list of allowed origins ("*" allows any origin). Requests
# from the bundled frontend are same-origin, so this only matters for other clients.
CORS_ORIGINS=https://localhost:3443
# debug | info | warn | error
LOG_LEVEL=info
APP_VERSION=1.0.0

# Host ports published by docker compose (the backend is not published)
HTTP_PORT=3000
HTTPS_PORT=3443

# Frontend (build time). Empty = same-origin requests to /api, proxied by nginx
# (and by Vite in local development).
VITE_API_URL=
