# The application: SPA, /api proxy, caching and security headers. Included by
# the HTTPS server and, with HTTP_MODE=app, by the HTTP server too.
# Rendered to /etc/nginx/conf.d/app.inc (outside the *.conf glob).

access_log /var/log/nginx/access.log main_rid;

root /usr/share/nginx/html;
index index.html;

gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;

include /etc/nginx/conf.d/security-headers.inc;

location /api/ {
    proxy_pass http://backend_api;
    # HTTP/1.1 with an empty Connection header enables upstream keepalive.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    # Every API call is side-effect free (POST /calculate included), so a
    # request that hit a replica being stopped can safely go to another.
    proxy_next_upstream error timeout http_502 http_503 non_idempotent;
    proxy_next_upstream_tries 3;
    client_max_body_size 1m;
}

# Hashed assets can be cached forever.
location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/conf.d/security-headers.inc;
    try_files $uri =404;
}

# SPA fallback; index.html is never cached so new deploys are picked up.
location / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/conf.d/security-headers.inc;
    try_files $uri $uri/ /index.html;
}
