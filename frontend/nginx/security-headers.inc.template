# Security headers, included by every HTTPS context that sends responses.
# nginx drops inherited add_header directives in any block that declares its
# own, so each such location includes this file again.
#
# Rendered to /etc/nginx/conf.d/security-headers.inc (the .inc suffix keeps it
# out of the conf.d/*.conf glob loaded by the main nginx.conf).

# Only our own scripts run; styles and fonts may also come from Google Fonts.
# connect-src must list the API origin when VITE_API_URL points elsewhere.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;

# max-age=0 by default: HSTS must only be enabled with a trusted certificate,
# otherwise browsers pin the host to a certificate they reject.
add_header Strict-Transport-Security "max-age=${HSTS_MAX_AGE}" always;

add_header X-Frame-Options "DENY" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
