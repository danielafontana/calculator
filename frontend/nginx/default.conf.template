# Rendered by the nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. Only environment variables that are defined
# (${HTTP_MODE}, ${PUBLIC_HTTPS_PORT}, ${BACKEND_ADDR}, ${NGINX_LOCAL_RESOLVERS})
# are substituted; nginx variables such as $host are left untouched.
#
# nginx runs as an unprivileged user, so it listens on 8080/8443 inside the
# container; docker compose publishes them as 3000/3443.

# Docker's embedded DNS, re-queried every 10s so replicas added with
# `docker compose up --scale backend=N` join the pool without a restart.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

upstream backend_api {
    zone backend_api 64k;
    server ${BACKEND_ADDR} resolve;
    # Reuse connections to the backend instead of opening one per request,
    # which otherwise caps throughput and exhausts ephemeral ports.
    keepalive 64;
    # Below the Go server's 60s IdleTimeout, so nginx never reuses a
    # connection the backend is about to close.
    keepalive_timeout 30s;
}

# Access log with the request ID that is also sent to the backend, so nginx
# and backend log lines can be correlated.
log_format main_rid '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                    '"$http_user_agent" rid=$request_id rt=$request_time';

# HTTP: health probe for Docker, plus either the app (HTTP_MODE=app, local)
# or a redirect to HTTPS (HTTP_MODE=redirect, production). Any other value
# makes nginx fail at startup, since the include file does not exist.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    include /etc/nginx/conf.d/http-${HTTP_MODE}.inc;
}

# HTTPS: serves the SPA and proxies /api to the backend, so the browser only
# talks to a single origin and the backend is never exposed directly.
server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # TLS 1.2: forward secrecy (ECDHE) + AEAD only, no CBC or static RSA key
    # exchange (Mozilla "intermediate"). TLS 1.3 suites are secure by default,
    # and OpenSSL 3.5 already prefers the hybrid post-quantum X25519MLKEM768.
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/conf.d/app.inc;
}
