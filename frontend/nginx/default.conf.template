# Rendered by the nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf. Only environment variables that are defined
# (${PUBLIC_HTTPS_PORT}, ${BACKEND_ADDR}, ${NGINX_LOCAL_RESOLVERS}) are
# substituted; nginx variables such as $host are left untouched.
#
# nginx runs as an unprivileged user, so it listens on 8080/8443 inside the
# container; docker compose publishes them as 3000/3443.

# Docker's embedded DNS, re-queried every 10s so replicas added with
# `docker compose up --scale backend=N` join the pool without a restart.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

upstream backend_api {
    zone backend_api 64k;
    server ${BACKEND_ADDR} resolve;
    # Reuse connections to the backend instead of opening one per request,
    # which otherwise caps throughput and exhausts ephemeral ports.
    keepalive 64;
    # Below the Go server's 60s IdleTimeout, so nginx never reuses a
    # connection the backend is about to close.
    keepalive_timeout 30s;
}

# Access log with the request ID that is also sent to the backend, so nginx
# and backend log lines can be correlated.
log_format main_rid '$remote_addr - [$time_local] "$request" $status $body_bytes_sent '
                    '"$http_user_agent" rid=$request_id rt=$request_time';

# HTTP: health probe for Docker, everything else is redirected to HTTPS.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host:${PUBLIC_HTTPS_PORT}$request_uri;
    }
}

# HTTPS: serves the SPA and proxies /api to the backend, so the browser only
# talks to a single origin and the backend is never exposed directly.
server {
    listen 8443 ssl;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # TLS 1.2: forward secrecy (ECDHE) + AEAD only, no CBC or static RSA key
    # exchange (Mozilla "intermediate"). TLS 1.3 suites are secure by default,
    # and OpenSSL 3.5 already prefers the hybrid post-quantum X25519MLKEM768.
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log /var/log/nginx/access.log main_rid;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    location /api/ {
        proxy_pass http://backend_api;
        # HTTP/1.1 with an empty Connection header enables upstream keepalive.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        # Every API call is side-effect free (POST /calculate included), so a
        # request that hit a replica being stopped can safely go to another.
        proxy_next_upstream error timeout http_502 http_503 non_idempotent;
        proxy_next_upstream_tries 3;
        client_max_body_size 1m;
    }

    # Hashed assets can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri =404;
    }

    # SPA fallback; index.html is never cached so new deploys are picked up.
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/security-headers.inc;
        try_files $uri $uri/ /index.html;
    }
}
