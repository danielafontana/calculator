{
  "info": {
    "_postman_id": "3ef2fd61-c39a-560b-b0f6-5711aa92bd2f",
    "name": "Calculator API",
    "description": "REST API of the full-stack calculator. Select the \"Calculator - Local\" environment: baseUrl is http://localhost:3000 (docker compose). When running the backend alone with `go run ./cmd/server`, set baseUrl to http://localhost:8080.\n\nEvery request has tests, so the whole collection can be run with the Collection Runner or newman. Rate limit: 10 req/s per client with a burst of 20.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Info",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Liveness check. `version` comes from the backend release tag (`dev` for local builds). Never rate limited."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.test('has a version', () => pm.expect(pm.response.json().version).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List operations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/operations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "operations"
              ]
            },
            "description": "Supported operations with symbol, description and number of operands."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const names = pm.response.json().operations.map((o) => o.name);",
                  "pm.test('lists the 7 operations', () => pm.expect(names).to.have.members(['add', 'subtract', 'multiply', 'divide', 'power', 'sqrt', 'percentage']));"
                ]
              }
            }
          ]
        }
      ]
    },
